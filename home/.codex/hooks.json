{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "SESSION_AGENT=codex $HOME/.agents/hooks/session-summarize-backfill.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5,
            "statusMessage": "Loading Rex terminal context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "command": "python3 \"$HOME/.agents/hooks/block_destructive_commands.py\"",
            "type": "command"
          },
          {
            "command": "\"$HOME/.agents/hooks/conventional-commit-check.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/.codex/hooks/session-history.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "SESSION_FINAL=1 $HOME/.codex/hooks/session-history.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
