 import org.junit.jupiter.api.Test;
 import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
 
 import java.io.ByteArrayOutputStream;
 import java.io.PrintStream;
@@ -135,9 +137,47 @@ class CliApplicationTest {
     }
 
     @Test
-    void thresholdExceededUsesStrictlyGreaterThanEight() {
-        assertFalse(CliApplication.thresholdExceeded(8.0));
-        assertTrue(CliApplication.thresholdExceeded(8.1));
+    void thresholdExceededUsesStrictlyGreaterThanTen() {
+        assertFalse(CliApplication.thresholdExceeded(9.0));
+        assertFalse(CliApplication.thresholdExceeded(10.0));
+        assertTrue(CliApplication.thresholdExceeded(Math.nextUp(10.0)));
+        assertTrue(CliApplication.thresholdExceeded(11.0));
+    }
+
+    @ParameterizedTest
+    @CsvSource({"9, 0", "10, 0", "11, 2"})
+    void exitCodeAndMessageUseTenAsTheLimit(int complexity, int expectedExit) throws Exception {
+        Path source = tempDir.resolve("src/Sample.java");
+        Files.createDirectories(source.getParent());
+        Files.writeString(source, "class Sample { int alpha(boolean flag) {\n"
+                + "if (flag) { return 1; }\n".repeat(complexity - 1)
+                + "return 0; } }\n");
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        ByteArrayOutputStream err = new ByteArrayOutputStream();
+        CoverageRunner coverageRunner = new CoverageRunner((command, directory) -> {
+            Path jacocoXml = directory.resolve("target/site/jacoco/jacoco.xml");
+            Files.createDirectories(jacocoXml.getParent());
+            Files.writeString(jacocoXml, """
+                    <report name="threshold">
+                      <package name="">
+                        <class name="Sample" sourcefilename="Sample.java">
+                          <method name="alpha" desc="(Z)I" line="1">
+                            <counter type="INSTRUCTION" missed="0" covered="100"/>
+                          </method>
+                        </class>
+                      </package>
+                    </report>
+                    """);
+            return 0;
+        });
+
+        int exit = new CliApplication(tempDir, new PrintStream(out), new PrintStream(err), coverageRunner)
+                .execute(new String[]{"src/Sample.java"});
+
+        assertEquals(expectedExit, exit);
+        assertTrue(out.toString().contains("alpha"));
+        assertEquals(expectedExit == 0 ? "" : "CRAP threshold exceeded: 11.0 > 10.0%n".formatted(),
+                err.toString());
     }
 
     @Test
