{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "7",
    "margin": 2
  },
  "block_quote": {
    "color": "8",
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "color": "7",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "1",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "1",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "9",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "3",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "2",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "6",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "4",
    "bold": true
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "3",
    "italic": true
  },
  "strong": {
    "color": "1",
    "bold": true
  },
  "hr": {
    "color": "8",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "4",
    "underline": true
  },
  "link_text": {
    "color": "6",
    "bold": true
  },
  "image": {
    "color": "4",
    "underline": true
  },
  "image_text": {
    "color": "8",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "1",
    "background_color": "0"
  },
  "code_block": {
    "color": "7",
    "margin": 2,
    "chroma": {
      "text": { "color": "7" },
      "error": { "color": "1" },
      "comment": { "color": "8" },
      "comment_preproc": { "color": "6" },
      "keyword": { "color": "1" },
      "keyword_reserved": { "color": "1" },
      "keyword_namespace": { "color": "6" },
      "keyword_type": { "color": "3" },
      "operator": { "color": "6" },
      "punctuation": { "color": "7" },
      "name": { "color": "7" },
      "name_builtin": { "color": "3" },
      "name_tag": { "color": "1" },
      "name_attribute": { "color": "2" },
      "name_class": { "color": "3" },
      "name_constant": { "color": "5" },
      "name_decorator": { "color": "6" },
      "name_exception": { "color": "1" },
      "name_function": { "color": "2" },
      "name_other": { "color": "4" },
      "literal": { "color": "5" },
      "literal_number": { "color": "5" },
      "literal_date": { "color": "5" },
      "literal_string": { "color": "2" },
      "literal_string_escape": { "color": "1" },
      "generic_deleted": { "color": "1" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "2" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "6" },
      "background": { "background_color": "0" }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
