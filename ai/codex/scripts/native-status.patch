@@ -0,0 +1,67 @@
+//! Optional user-selected Git footer helper, executed in the active workspace.
+//!
+//! `CODEX_GIT_CONTEXT_HELPER` names an executable supplied by the launcher. It
+//! receives `label` or `changes`; the latter returns JSON additions and deletions.
+//! Keeping the command outside project configuration avoids running arbitrary
+//! repository-selected code when rendering the footer.
+
+use std::path::Path;
+use std::time::Duration;
+
+use crate::branch_summary::GitBranchDiffStats;
+use crate::branch_summary::StatusLineGitSummary;
+use crate::branch_summary::open_pull_request;
+use crate::workspace_command::WorkspaceCommand;
+use crate::workspace_command::WorkspaceCommandExecutor;
+
+pub(crate) async fn label(
+    runner: &dyn WorkspaceCommandExecutor,
+    cwd: &Path,
+    helper: &str,
+) -> Option<String> {
+    let output = run(runner, cwd, helper, "label").await?;
+    let label = output.trim();
+    (!label.is_empty() && !label.contains(['\r', '\n'])).then(|| label.to_owned())
+}
+
+pub(crate) async fn summary(
+    runner: &dyn WorkspaceCommandExecutor,
+    cwd: &Path,
+    helper: &str,
+) -> StatusLineGitSummary {
+    let (pull_request, branch_change_stats) =
+        tokio::join!(open_pull_request(runner, cwd), changes(runner, cwd, helper),);
+    StatusLineGitSummary {
+        pull_request,
+        branch_change_stats,
+    }
+}
+
+async fn changes(
+    runner: &dyn WorkspaceCommandExecutor,
+    cwd: &Path,
+    helper: &str,
+) -> Option<GitBranchDiffStats> {
+    serde_json::from_str(&run(runner, cwd, helper, "changes").await?).ok()
+}
+
+async fn run(
+    runner: &dyn WorkspaceCommandExecutor,
+    cwd: &Path,
+    helper: &str,
+    mode: &str,
+) -> Option<String> {
+    let output = runner
+        .run(
+            WorkspaceCommand::new([helper, mode])
+                .cwd(cwd)
+                .timeout(Duration::from_secs(/*secs*/ 15)),
+        )
+        .await
+        .ok()?;
+    output.success().then_some(output.stdout)
+}
+
+#[cfg(test)]
+#[path = "custom_git_context_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/custom_git_context_tests.rs b/codex-rs/tui/src/custom_git_context_tests.rs
new file mode 100644
index 000000000..283a23859
--- /dev/null
+++ b/codex-rs/tui/src/custom_git_context_tests.rs
@@ -0,0 +1,90 @@
+use super::*;
+use crate::workspace_command::WorkspaceCommandError;
+use crate::workspace_command::WorkspaceCommandOutput;
+use pretty_assertions::assert_eq;
+use std::future::Future;
+use std::pin::Pin;
+
+struct Runner {
+    mode: &'static str,
+    exit_code: i32,
+    stdout: &'static str,
+}
+
+impl WorkspaceCommandExecutor for Runner {
+    fn run(
+        &self,
+        command: WorkspaceCommand,
+    ) -> Pin<
+        Box<dyn Future<Output = Result<WorkspaceCommandOutput, WorkspaceCommandError>> + Send + '_>,
+    > {
+        assert_eq!(command.argv, vec!["/helper with spaces", self.mode]);
+        assert_eq!(command.cwd.as_deref(), Some(Path::new("/workspace")));
+        Box::pin(async {
+            Ok(WorkspaceCommandOutput {
+                exit_code: self.exit_code,
+                stdout: self.stdout.to_owned(),
+                stderr: String::new(),
+            })
+        })
+    }
+}
+
+#[tokio::test]
+async fn worktree_label_is_returned_without_shell_interpolation() {
+    let runner = Runner {
+        mode: "label",
+        exit_code: 0,
+        stdout: "w:workspace-task\n",
+    };
+    assert_eq!(
+        label(&runner, Path::new("/workspace"), "/helper with spaces").await,
+        Some("w:workspace-task".to_owned())
+    );
+}
+
+#[tokio::test]
+async fn failed_or_multiline_label_is_omitted() {
+    for (exit_code, stdout) in [(1, "w:partial"), (0, "w:first\nsecond"), (0, "")] {
+        let runner = Runner {
+            mode: "label",
+            exit_code,
+            stdout,
+        };
+        assert_eq!(
+            label(&runner, Path::new("/workspace"), "/helper with spaces").await,
+            None
+        );
+    }
+}
+
+#[tokio::test]
+async fn helper_changes_are_parsed_as_native_diff_counts() {
+    let runner = Runner {
+        mode: "changes",
+        exit_code: 0,
+        stdout: r#"{"additions":12,"deletions":3}"#,
+    };
+    assert_eq!(
+        changes(&runner, Path::new("/workspace"), "/helper with spaces").await,
+        Some(GitBranchDiffStats {
+            additions: 12,
+            deletions: 3,
+        })
+    );
+}
+
+#[tokio::test]
+async fn unavailable_or_invalid_counts_are_omitted() {
+    for stdout in ["null", "not JSON", r#"{"additions":-1,"deletions":3}"#] {
+        let runner = Runner {
+            mode: "changes",
+            exit_code: 0,
+            stdout,
+        };
+        assert_eq!(
+            changes(&runner, Path::new("/workspace"), "/helper with spaces").await,
+            None
+        );
+    }
+}
